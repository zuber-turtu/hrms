# Security & JWT Configuration
SECRET_KEY=949f298c4a91eb8f4f346b97d283c7b396b29b6f4e3c
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Backend (Choose SQLite or Supabase PostgreSQL)
# 1. Local SQLite (Default fallback):
# DATABASE_URL=sqlite:///./hrms.db

# 2. Supabase PostgreSQL (Direct or Pooler Connection URI):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./hrms.db
 
# ================================================================
# Multi-Cloud Storage Configuration (Documents, KYC, Avatars)
# ================================================================
# Storage Provider Options: local | gdrive | supabase | cloudflare | s3
STORAGE_PROVIDER=local

# Option 1: Local Disk (Default)
# Stored inside /static/uploads/avatars and /static/uploads/documents

# Option 2: Google Drive (15 GB Free Storage)
# GDRIVE_SERVICE_ACCOUNT_FILE=service_account.json
# GDRIVE_FOLDER_ID=1a2B3c4D5e6F7g8H9i0J_kLmNoPqRsTuV

# Option 3: Supabase Storage (S3-compatible bucket or REST)
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SUPABASE_BUCKET_NAME=hrms-storage

# Option 4: Cloudflare R2 (Zero egress fees, S3-compatible)
# S3_BUCKET_NAME=hrms-storage
# S3_ACCESS_KEY_ID=your_r2_access_key_id
# S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL_PREFIX=https://cdn.yourcompany.com
# S3_REGION_NAME=auto

# Option 5: AWS S3 / MinIO
# S3_BUCKET_NAME=hrms-production-vault
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
