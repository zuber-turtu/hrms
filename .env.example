# ==============================================================================
# Company HRMS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY
# ------------------------------------------------------------------------------
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

COOKIE_NAME=access_token
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. DATABASE BACKEND (MySQL Preferred, PostgreSQL, or SQLite)
# ------------------------------------------------------------------------------
# Option A: MySQL 8.0+ / MariaDB (Preferred Enterprise Option for High Concurrency)
DATABASE_URL=mysql+pymysql://hrms_user:YourStrongPassword123!@localhost:3306/hrms_db

# Option B: PostgreSQL / Supabase
# DATABASE_URL=postgresql://hrms_user:YourStrongPassword123!@localhost:5432/hrms_db
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option C: Local SQLite (Zero-Setup for quick local trial only)
# DATABASE_URL=sqlite:///./hrms.db

# ------------------------------------------------------------------------------
# 3. STORAGE ENGINE (Select One: local | supabase | gdrive | cloudflare | s3)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local

# --- Option A: Local Server Storage (Default) ---
# Files are stored in static/uploads/avatars and static/uploads/documents

# --- Option B: Supabase Storage ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_BUCKET_NAME=hrms-storage

# --- Option C: Google Drive (15 GB Free Storage) ---
# GDRIVE_SERVICE_ACCOUNT_FILE=service_account.json
# GDRIVE_FOLDER_ID=your_google_drive_folder_id_here

# --- Option D: Cloudflare R2 (Zero egress fees, S3-compatible) ---
# S3_BUCKET_NAME=hrms-storage
# S3_ACCESS_KEY_ID=your_r2_access_key_id
# S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL_PREFIX=https://cdn.yourcompany.com
# S3_REGION_NAME=auto

# --- Option E: AWS S3 / MinIO ---
# S3_BUCKET_NAME=hrms-production-vault
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_REGION_NAME=ap-south-1

# ------------------------------------------------------------------------------
# 4. EMAIL & SMTP CONFIGURATION (Password Resets & Notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="HRMS Notifications"
SMTP_USE_TLS=True

# Base URL for Email Links
APP_BASE_URL=http://localhost:8000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
