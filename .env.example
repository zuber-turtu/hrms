# ==============================================================================
# Company HRMS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY
# ------------------------------------------------------------------------------
ENVIRONMENT=production
IS_PRODUCTION=false
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

COOKIE_NAME=access_token
COOKIE_SAMESITE=lax
# Auto-enforced to True if IS_PRODUCTION=true
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. DATABASE BACKEND (MySQL 8.0+, PostgreSQL / Supabase, or SQLite)
# ------------------------------------------------------------------------------
# Option A: MySQL 8.0+ / MariaDB (Recommended for Production & High Concurrency)
DATABASE_URL=mysql://hrms_user:YourStrongPassword123!@localhost:3306/hrms_db
# Note: SQLAlchemy will automatically use mysql+pymysql:// under the hood.

# Option B: PostgreSQL (Self-Hosted)
# DATABASE_URL=postgresql://hrms_user:YourStrongPassword123!@localhost:5432/hrms_db

# Option C: Supabase Managed PostgreSQL
# DATABASE_URL=postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option D: SQLite (Zero-Setup Local Development Only)
# DATABASE_URL=sqlite:///./hrms.db

# ------------------------------------------------------------------------------
# 3. PLUGGABLE STORAGE BACKEND (Select One: local | s3 | cloudflare | supabase | gdrive)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local

# --- Option A: Local Disk Storage (Default for Local Development) ---
# Confidential employee KYC documents are stored privately in storage/private_documents/
# Public profile avatars are stored in static/uploads/avatars/

# --- Option B: AWS S3 (Recommended Enterprise Storage) ---
# S3_BUCKET_NAME=your-production-hrms-bucket
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_REGION_NAME=ap-south-1
# S3_PUBLIC_URL_PREFIX=https://your-production-hrms-bucket.s3.ap-south-1.amazonaws.com

# --- Option C: Cloudflare R2 (S3-Compatible, 10 GB Free Tier, Zero Egress Fees) ---
# S3_BUCKET_NAME=hrms-storage
# S3_ACCESS_KEY_ID=your_r2_access_key_id
# S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
# S3_ENDPOINT_URL=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL_PREFIX=https://cdn.yourcompany.com
# S3_REGION_NAME=auto

# --- Option D: Supabase Storage ---
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SUPABASE_BUCKET_AVATARS=hrms-avatars
# SUPABASE_BUCKET_DOCS=hrms-documents

# --- Option E: Google Drive (15 GB Free Storage via Google Cloud Service Account) ---
# GDRIVE_SERVICE_ACCOUNT_FILE=service_account.json
# GDRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ------------------------------------------------------------------------------
# 4. EMAIL & SMTP CONFIGURATION (Password Resets, Leave Alerts, Security Notices)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="TURTU HRMS"
SMTP_USE_TLS=True

# Base URL for Email Links (Portal links inside emails)
APP_BASE_URL=http://localhost:8000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 5. HIGH-CONCURRENCY REDIS CACHE & ASYNC ENGINE SETTINGS
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_POOL_SIZE=50
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# Connection Pool Configurations:
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=15
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 6. COMPANY STATUTORY & OPERATIONAL DEFAULTS
# ------------------------------------------------------------------------------
COMPANY_NAME="TURTU INDIA LLP"
COMPANY_CURRENCY_SYMBOL="₹"
COMPANY_CURRENCY_CODE="INR"
TIMEZONE_OFFSET_MINUTES=330
APP_TIMEZONE="IST"
