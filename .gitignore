# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's sample, not the project.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different python versions, they may
#   encounter dependency resolution issues.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to be committed.
#https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to be committed.
#pdm.lock
#   pdm local configuration
.pdm-python
.pdm-db/

# lsvb
.dmcache
.lvimrc

# Poetry
